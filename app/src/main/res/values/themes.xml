<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The Compose theme in ui/theme/Theme.kt owns every colour once the first
        frame draws. This XML theme only has to cover the window before that
        happens, otherwise the status bar and window background flash the
        Android Studio template purple.

        It previously extended Theme.MaterialComponents.DarkActionBar, which is
        Material 2, while the app is built entirely on Material 3. The app now
        draws its own top bar, so the platform action bar is removed rather than
        left to fight the Compose Scaffold.
    -->
    <style name="Theme.WorkoutApp" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_background</item>
        <item name="android:navigationBarColor">@color/brand_background</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
