rules_version = '2';

// The app stores every Firestore document under users/{uid}/...
// Collections in use (see FirestoreRepository):
//   profiles, exercises, categories, sessions, sessionExercises,
//   restDays, templates, settings/default, meta/migration, counters/{collection}.
//
// One recursive match enforces single-user isolation for all of them.
// Per-field validation is intentionally left out: the document schema
// evolves with app releases, and a strict field rule would brick
// reads/writes until the deployed rules catch up. Ownership of the
// user subtree is the security boundary.
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicitly deny anything outside a signed-in user's own subtree.
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid;
    }
  }
}
